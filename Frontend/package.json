{
  "name": "vovinam-frontend",
  "private": true,
  "version": "2.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "start": "node server.mjs",
    "build:live": "vite build --mode live",
    "dev:api": "vite --mode api --host 127.0.0.1",
    "build:fixtures": "vite build --mode fixtures --outDir dist-fixtures",
    "preview:fixtures": "vite preview --outDir dist-fixtures --host 127.0.0.1",
    "mock:server": "node tools/mock-server.mjs",
    "contract:generate": "node scripts/generate-handoff.mjs",
    "test:contract": "node --test tests/handoff*.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}